# =============================================================================
#  Ambiente de Desenvolvimento — aqua-dev
#  Copie para .env e ajuste os valores
# =============================================================================

# Django
DJANGO_SETTINGS_MODULE=config.settings
DEBUG=1
DJANGO_SECRET_KEY=<gerar-com: python -c "import secrets; print(secrets.token_urlsafe(64))">

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Flood Monitoring (o Compose dev força proxy e fila dedicada)
FLOOD_CAMERA_API_MODE=proxy
FLOOD_CAMERA_SERVICE_URL=http://flood-api:8091
FLOOD_CAMERA_PROXY_CONNECT_TIMEOUT_SECONDS=2
FLOOD_CAMERA_PROXY_READ_TIMEOUT_SECONDS=120
FLOOD_CAMERA_DEDICATED_QUEUE=1

# Database (PostgreSQL)
POSTGRES_DB=aqua_dev
POSTGRES_USER=aqua_dev
POSTGRES_PASSWORD=<sua-senha-dev>
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Portas do Docker Compose (ajuste se houver conflito)
WEB_PORT=8001
DB_PORT=5434

# Remote API Sync (use localhost para testes ou URL de produção)
API_URL=http://localhost:8001
API_EMAIL=<seu-email>
API_PASSWORD=<sua-senha>

# Mercado Pago (token de teste ou placeholder)
ACCESS_TOKEN=dev-token-placeholder

# Google Drive ID do modelo de ML (placeholder para dev)
FLOOD_MODEL_DRIVE_ID=dev-drive-id-placeholder

# Demo determinística — o perfil demo controla o container
DEMO_ENABLED=1
DEMO_CONTROL_TOKEN=dev-demo-token
DEMO_VIDEO_ATTACHMENT_KEY=<attachment-key-retornado-pelo-uploader>
DEMO_SCENARIO_PATH=/demo-assets/scenario.json
DEMO_WORK_DIR=/tmp/aqua-demo-stream
DEMO_PREDICTION_CACHE_SECONDS=30
DEMO_STREAM_INTERNAL_URL=http://demo-stream:8089
DEMO_STREAM_MEDIA_INTERNAL_BASE_URL=http://demo-stream:8088
DEMO_STREAM_PUBLIC_URL=http://localhost:8088/hls/playlist.m3u8
DEMO_STREAM_PORT=8088

# Limites do uploader (10 MiB para imagens; 500 MiB para vídeos)
UPLOADER_IMAGE_MAX_BYTES=10485760
UPLOADER_VIDEO_MAX_BYTES=524288000
