FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System libs for Geo stack (GDAL/GEOS/PROJ) + build essentials (removed later)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gdal-bin libgdal-dev \
    libgeos-dev \
    proj-bin libproj-dev \
    build-essential gcc && \
    rm -rf /var/lib/apt/lists/*

# Install runtime Python deps
COPY docker/requirements.runtime.txt /tmp/requirements.txt
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r /tmp/requirements.txt

# Copy only what’s needed at runtime to minimize context
COPY manage.py ./
COPY config ./config
COPY core ./core

EXPOSE 8090

ENV DJANGO_SETTINGS_MODULE=config.settings

CMD ["python", "manage.py", "runserver", "0.0.0.0:8090"]
